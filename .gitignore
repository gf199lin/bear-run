# ==========================================
# 熊二快跑 · Bear Run —— 不纳入版本控制的文件
# ==========================================
# 说明：被忽略的文件仍留在你本地，只是不会被提交到 GitHub。
# 这样老师 clone 下来的仓库就是干净的游戏本体。

# ---- 开发调试用页面（游戏本体不依赖，index.html 照常运行）----
_*.html

# ---- 雷达回放录制数据（体积大、且是本地游玩产物）----
_radarreplay/

# ---- 操作系统自动生成的文件 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 编辑器 / IDE 配置 ----
.vscode/
.idea/
*.swp

# ---- 临时文件与日志 ----
*.log
tmp/

# ---- Python 缓存（工具脚本运行产物）----
__pycache__/
*.pyc

# ---- 雷达代理的运行时依赖（随目录拷贝即可，不进仓库）----
# runtime/node.exe 约 79MB; node_modules 可用 npm install 重新生成
radar-agent/runtime/
radar-agent/node_modules/
