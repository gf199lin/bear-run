# ---------- 临时与生成物（不属交付物） ----------
.deepworks/tmp/
__pycache__/
*.py[cod]

# ---------- 采集数据与运行日志 ----------
# 雷达录制为不含图像的人体数据，按课程保密要求不入库
*.bin
# 例外：纯合成样本（不含人体数据），供无硬件演示使用
!radar-pointcloud/sample-synthetic.bin
*.log
*.err

# 标定 / 实验采集的原始帧（npz、逐帧 json）一律不入库。
# 纯合成或人工构造的样本如需入库，请放在 data/ 之外。
data/

# 环境底噪基线（空场采集所得，随场地/场次变化，属现场产物而非交付物）
radar-pointcloud/bg_baseline.json
radar-pointcloud/bg_baseline.json.tmp

# ---------- 保密材料：厂商资料 / 授权 / 课程上传 ----------
uploads/
*.lic
*.zip
ONELAB*/

# ---------- 本地环境配置（含本机绝对路径） ----------
.opencode/deepworks.json

# clone 元数据备份（只为保留可还原性，不入库）
bear-run-new/.git-clone-backup/

# ---------- 缓存与旧版目录副本 ----------
cache/
radar-kit-1030/
radar-runner-1030/

# 内容不明的零散文件（根目录遗留，非项目内容）
/Bear

# ---------- 扫参中间产物：只留关键结论 json ----------
# 门限/窗口/延迟扫描的每一步结果，靠上面的脚本可复现，不逐个入库
outputs/lane-eval/lat*.json
outputs/lane-eval/scan-*.json
outputs/lane-eval/smoke.json
