# ---------- 临时与生成物（不属交付物） ----------
.deepworks/tmp/
__pycache__/
*.py[cod]

# ---------- 采集数据与运行日志 ----------
# 雷达录制为不含图像的人体数据，按课程保密要求不入库
*.bin
# 例外：纯合成样本（不含人体数据），供无硬件演示使用
!radar-pointcloud/sample-synthetic.bin
*.log
*.err

# 环境底噪基线（空场采集所得，随场地/场次变化，属现场产物而非交付物）
radar-pointcloud/bg_baseline.json
radar-pointcloud/bg_baseline.json.tmp

# ---------- 保密材料：厂商资料 / 授权 / 课程上传 ----------
uploads/
*.lic
*.zip
ONELAB*/

# ---------- 本地环境配置（含本机绝对路径） ----------
.opencode/deepworks.json
